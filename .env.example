# =============================================================================
# Alfa Business News Analytics — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
PROJECT_NAME="Alfa Business News Analytics"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Database ----------------------------------------------------------------
# Local SQLite (instant start, no Docker required):
DATABASE_URL=sqlite+aiosqlite:///./alfa_analytics.db

# Docker / Production PostgreSQL (uncomment and fill):
# DATABASE_URL=postgresql+asyncpg://alfa_user:alfa_password@localhost:5432/alfa_analytics

# --- Redis & Event Bus -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Set to false when Redis is available (docker-compose sets this automatically)
USE_IN_MEMORY_BUS=true

# --- Security ----------------------------------------------------------------
SECRET_KEY=alfa-hackathon-secret-key-change-in-production

# --- LLM Agent — Chat Completions API ----------------------------------------
# Full URL to the /chat/completions endpoint of the hackathon LLM gateway.
# Examples:
#   https://llm-proxy.alfabank.ru/v1/chat/completions
#   http://localhost:11434/v1/chat/completions  (local Ollama)
AGENT_LLM_API_URL=https://api.example.com/v1/chat/completions

# Model name from the approved list (Gemma, GLM, Qwen, DeepSeek, Kimi):
AGENT_LLM_MODEL=gemma-3-27b-it

# Auth header name and value (usually "Authorization" + "Bearer <key>"):
AGENT_LLM_AUTH_HEADER=Authorization
AGENT_LLM_AUTH_VALUE=Bearer your-api-key-here

# Per-request timeout in seconds:
AGENT_LLM_TIMEOUT_SECONDS=60

# Max tokens per LLM response:
AGENT_LLM_MAX_OUTPUT_TOKENS=2048

# Field name for max tokens (use "max_completion_tokens" for OpenAI o-models):
AGENT_LLM_TOKEN_LIMIT_FIELD=max_tokens

# --- LLM Budget Guardian (daily spend cap) -----------------------------------
LLM_MAX_DAILY_BUDGET_RUB=500.0
# Set to true to fall back to MockMLInsightEngine when LLM is unavailable:
LLM_FALLBACK_TO_MOCK=true
