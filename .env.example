# Application Settings
PROJECT_NAME="Alfa Business News Analytics"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
# For local run: sqlite+aiosqlite:///./alfa_analytics.db
# For docker / prod: postgresql+asyncpg://alfa_user:alfa_password@postgres:5432/alfa_analytics
DATABASE_URL=sqlite+aiosqlite:///./alfa_analytics.db

# Redis & Event Bus
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_BUS=true

# LLM Gateway & Budget Guardian
LLM_API_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-api-key-here
LLM_MAX_DAILY_BUDGET_RUB=500.0
LLM_FALLBACK_TO_MOCK=true
